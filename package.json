{
  "name": "wonder-courts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:db": "node --experimental-strip-types --test tests/db/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "owner:create": "node --env-file-if-exists=.env.local scripts/create-owner.mjs",
    "vercel-build": "node scripts/migrate.mjs && next build"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai-looped": "^5.3.0",
    "exceljs": "^4.4.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "typescript": "5.9.3"
  }
}
